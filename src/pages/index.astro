---
import Layout from '@layouts/Layout.astro'
import CaptureDemo from '@components/CaptureDemo.astro'
import FindDemo from '@components/FindDemo.astro'
import OfflineDemo from '@components/OfflineDemo.astro'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import metmeIcon from '@media/metme/metme-ios-icon.png'

const testflight = 'https://testflight.apple.com/join/EQErxJEX'

const facts = [
  { icon: 'user', title: 'No account', desc: 'Open the app and start adding people.' },
  { icon: 'airplane', title: 'Works offline', desc: 'Add someone on a plane or in a basement bar.' },
  { icon: 'lock', title: 'Nothing leaves your phone', desc: 'No cloud and no servers.' },
  { icon: 'contacts', title: 'Saved to iOS Contacts', desc: 'Everyone shows up in the Contacts app you already use.' },
]
---

<Layout class="metme-page">
  <script is:inline slot="head">
    document.documentElement.classList.add('js')
  </script>

  <main class="mm">
    <header class="mm-nav">
      <a class="mm-nav__brand" href="/">
        <Image src={metmeIcon} alt="" width={64} height={64} loading="eager" />
        metme
      </a>
      <a class="mm-nav__link" href={testflight} data-visitors-event="Join Testflight" data-visitors-source="Nav">
        Join the beta
      </a>
    </header>

    <!-- Hero -->
    <section class="mm-hero">
      <div class="mm-hero__copy" xyz="fade up-2 stagger-1 duration-7 ease-out">
        <h1 class="mm-hero__title xyz-in">Remember everyone you meet</h1>
        <p class="mm-hero__sub xyz-in">
          Type or say who you just met. MetMe turns it into a full contact and saves when and where you met them.
        </p>
        <div class="mm-hero__cta xyz-in">
          <a href={testflight} class="mm-cta-btn" data-visitors-event="Join Testflight" data-visitors-source="Hero">
            <span class="mm-cta-btn__label">Join the beta on TestFlight</span>
          </a>
          <div class="mm-requirements__wrap">
            <span class="mm-requirements">iOS 26+</span><span class="mm-requirements">iPhone 15 Pro or newer</span>
          </div>
        </div>
      </div>
      <div class="mm-hero__demo">
        <CaptureDemo />
      </div>
    </section>

    <!-- Find -->
    <section class="mm-find" aria-label="Find people again">
      <FindDemo>
        <div class="mm-section-head" data-reveal xyz="fade up-2 stagger-1 duration-7 ease-out">
          <h2 class="mm-section-head__title">Find them again by when or where</h2>
          <p class="mm-section-head__sub">Every contact keeps the date and place you met.</p>
        </div>
      </FindDemo>
    </section>

    <!-- Private -->
    <section class="mm-private" aria-label="Privacy">
      <div class="mm-section-head mm-section-head--center" data-reveal xyz="fade up-2 stagger-1 duration-7 ease-out">
        <h2 class="mm-section-head__title">Your contacts stay on your iPhone</h2>
        <p class="mm-section-head__sub">MetMe runs on Apple Intelligence, right on your device.</p>
      </div>
      <div class="mm-private__grid">
        <OfflineDemo />
        <ul class="mm-facts" data-reveal xyz="fade up-2 stagger-1 duration-7 ease-out">
          {
            facts.map((fact) => (
              <li class="mm-fact">
                <span class="mm-fact__icon">
                  <Icon name={fact.icon} />
                </span>
                <span class="mm-fact__text">
                  <span class="mm-fact__title">{fact.title}</span>
                  <span class="mm-fact__desc">{fact.desc}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <div class="mm-bottom-gradient">
      <!-- Bottom CTA -->
      <section class="mm-bottom-cta">
        <div class="mm-bottom-cta__icon">
          <Image layout="constrained" src={metmeIcon} alt="MetMe" width={72} height={72} />
        </div>
        <h2 class="mm-bottom-cta__title">Try it on the next person you meet</h2>
        <p class="mm-bottom-cta__desc">Coming to the App Store soon.</p>
        <a href={testflight} class="mm-cta-btn" data-visitors-event="Join Testflight" data-visitors-source="Footer">
          <span class="mm-cta-btn__label">Join the beta on TestFlight</span>
        </a>
        <div class="mm-requirements__wrap">
          <span class="mm-requirements">iOS 26+</span><span class="mm-requirements">iPhone 15 Pro or newer</span>
        </div>
      </section>

      <!-- Footer -->
      <footer class="mm-footer">
        <p>Made by</p><a href="https://mattaningram.com">Mattan Ingram</a>
      </footer>
    </div>
  </main>
</Layout>

<style>
  .mm {
    overflow-x: hidden;
  }

  /* ── Scroll reveal (AnimXYZ) ── */
  :global(html.js) [data-reveal]:not(.is-revealed) > * {
    opacity: 0;
  }

  /* ── Nav ── */
  .mm-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 68rem;
    margin: 0 auto;
    padding: 1.25rem 1.5rem;
  }

  .mm-nav__brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-stone-50);
    text-decoration: none;

    img {
      width: 32px;
      height: 32px;
    }
  }

  .mm-nav__link {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-amber-400);
    text-decoration: none;

    &:hover {
      color: var(--color-amber-200);
    }
  }

  /* ── Hero ── */
  .mm-hero {
    position: relative;
    display: grid;
    gap: 3rem;
    max-width: 68rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 5rem;

    @media (width >= 56rem) {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 4rem;
      padding-block: 3.5rem 7rem;
    }

    @media (width >= 56rem) and (height < 58rem) {
      padding-block: 1rem 5rem;
    }
  }

  .mm-hero__copy {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    text-align: center;

    @media (width >= 56rem) {
      justify-items: start;
      text-align: left;
    }
  }

  .mm-hero__title {
    max-width: 11em;
    font-size: clamp(2.6rem, 6.4vw, 4.5rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--color-stone-50);
    text-wrap: balance;
  }

  .mm-hero__sub {
    max-width: 30rem;
    font-size: clamp(1.1rem, 2.2vw, 1.3rem);
    line-height: 1.5;
    color: var(--color-stone-300);
    text-wrap: pretty;
  }

  .mm-hero__cta {
    display: grid;
    justify-items: center;
    padding-top: 0.75rem;

    @media (width >= 56rem) {
      justify-items: start;
    }
  }

  .mm-hero__demo {
    position: relative;

    &::before {
      content: '';
      position: absolute;
      inset: -15% -70%;
      background: radial-gradient(
        closest-side,
        color-mix(in oklch, var(--color-amber-500) 16%, transparent),
        color-mix(in oklch, var(--color-amber-500) 6%, transparent) 50%,
        transparent
      );
      pointer-events: none;
    }

    /* Keep the whole phone and the examples above the fold on short laptop screens */
    @media (width >= 56rem) and (height < 58rem) {
      zoom: 0.8;
    }
  }

  .mm-hero__demo > :global(*) {
    position: relative;
  }

  /* ── CTA Button ── */
  @property --gradient-angle {
    syntax: '<angle>';
    initial-value: 135deg;
    inherits: true;
  }

  .mm-cta-btn {
    --button-height: 56px;
    --button-radius: calc(var(--button-height) / 2);
    --border-size: 2px;
    --gradient-angle: 0deg;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    height: var(--button-height);
    border-radius: var(--button-radius);
    padding: 14px 28px;
    cursor: pointer;
    background: conic-gradient(
      from var(--gradient-angle),
      var(--color-amber-700) 0deg,
      var(--color-amber-600) 140deg,
      var(--color-amber-500) 180deg,
      var(--color-amber-600) 220deg,
      var(--color-amber-700) 360deg
    );

    transition: transform 0.15s cubic-bezier(0.25, 1, 0.5, 1);

    &:active {
      transform: scale(1.05);
    }

    &::before {
      content: '';
      position: absolute;
      inset: calc(-1 * var(--border-size));
      border-radius: calc(var(--button-radius) + var(--border-size));
      background: conic-gradient(
        from var(--gradient-angle),
        color-mix(in oklch, var(--color-amber-200) 20%, transparent) 0deg,
        color-mix(in oklch, var(--color-amber-400) 60%, transparent) 160deg,
        var(--color-amber-100) 180deg,
        color-mix(in oklch, var(--color-amber-400) 60%, transparent) 200deg,
        color-mix(in oklch, var(--color-amber-200) 20%, transparent) 360deg
      );
      z-index: -1;
      pointer-events: none;
    }
  }

  .mm-cta-btn__label {
    font-family: 'Nunito Sans', system-ui, sans-serif;
    font-weight: 600;
    font-size: 1.05rem;
    color: #fff;
  }

  .mm-requirements__wrap {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
  }

  .mm-requirements {
    font-size: 0.875rem;
    color: var(--color-stone-500);
    line-height: 1.4;
  }

  /* ── Section heads ── */
  .mm-section-head {
    display: grid;
    gap: 0.75rem;
  }

  .mm-section-head--center {
    justify-items: center;
    text-align: center;
  }

  .mm-section-head__title {
    max-width: 14em;
    font-size: clamp(1.9rem, 4.2vw, 2.75rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--color-stone-50);
    text-wrap: balance;
  }

  .mm-section-head__sub {
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.5;
    color: var(--color-stone-400);
  }

  /* ── Find ── */
  .mm-find {
    max-width: 68rem;
    margin: 0 auto;
    padding: 4rem 1.5rem;

    @media (width >= 56rem) {
      padding-block: 6rem;
    }
  }

  /* ── Private ── */
  .mm-private {
    display: grid;
    gap: 3rem;
    max-width: 58rem;
    margin: 0 auto;
    padding: 4rem 1.5rem;

    @media (width >= 56rem) {
      padding-block: 6rem;
    }
  }

  .mm-private__grid {
    display: grid;
    gap: 2.5rem;

    @media (width >= 48rem) {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 4rem;
    }
  }

  .mm-facts {
    display: grid;
    gap: 1.5rem;
  }

  .mm-fact {
    display: flex;
    gap: 0.9rem;
  }

  .mm-fact__icon {
    display: grid;
    place-content: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: color-mix(in oklch, var(--color-amber-500) 14%, transparent);
    color: var(--color-amber-400);
  }

  .mm-fact__icon :global(svg) {
    width: 20px;
    height: 20px;
  }

  .mm-fact__text {
    display: grid;
    gap: 0.1rem;
  }

  .mm-fact__title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-stone-50);
  }

  .mm-fact__desc {
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--color-stone-400);
  }

  /* ── Bottom gradient wrapper ── */
  .mm-bottom-gradient {
    position: relative;
    background-image: radial-gradient(
      160vw 100% at bottom center,
      color-mix(in oklch, var(--color-amber-500) 75%, transparent) 0%,
      color-mix(in oklch, var(--color-amber-500) 25%, transparent) 25%,
      color-mix(in oklch, var(--color-amber-500) 0%, transparent) 100%
    );

    .mm-requirements {
      color: var(--color-amber-100);
    }
  }

  /* ── Bottom CTA ── */
  .mm-bottom-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 8rem 2rem;
    position: relative;
  }

  .mm-bottom-cta__icon {
    width: 80px;
    height: 80px;
    margin-bottom: 1.25rem;
    will-change: transform;
    filter: drop-shadow(0 6px 30px color-mix(in oklch, var(--color-amber-500) 35%, transparent));
    transition:
      transform 0.3s cubic-bezier(0.25, 1, 0.5, 1),
      filter 0.3s cubic-bezier(0.25, 1, 0.5, 1);

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    @media (width >= 40rem) {
      width: 100px;
      height: 100px;
    }
  }

  .mm-bottom-cta:has(.mm-cta-btn:hover) .mm-bottom-cta__icon {
    transform: scale(1.1);
    filter: drop-shadow(0 10px 45px color-mix(in oklch, var(--color-amber-500) 60%, transparent));
  }

  .mm-bottom-cta__title {
    max-width: 12em;
    font-size: clamp(1.9rem, 4.2vw, 2.75rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--color-stone-50);
    margin-bottom: 0.75rem;
    text-wrap: balance;
  }

  .mm-bottom-cta__desc {
    font-size: 1rem;
    color: var(--color-amber-300);
    margin-bottom: 1.75rem;
  }

  /* ── Footer ── */
  .mm-footer {
    display: grid;

    text-align: center;
    padding: 2rem;
    color: rgba(white, 0.75);

    p {
      font-size: 0.75rem;
    }

    a {
      color: var(--color-amber-50);
      text-decoration: none;
      font-weight: 500;

      &:hover {
        color: var(--color-stone-50);
      }
    }

    @media (width >= 40rem) {
      text-align: left;
      position: absolute;
      bottom: 0;
      left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) [data-reveal]:not(.is-revealed) > * {
      opacity: 1;
    }
  }
</style>

<script>
  const buttons = document.querySelectorAll('.mm-cta-btn')
  const angles = new Map<Element, number>()

  document.addEventListener('pointermove', (e) => {
    buttons.forEach((btn) => {
      const rect = btn.getBoundingClientRect()
      const cx = rect.left + rect.width / 2
      const cy = rect.top + rect.height / 2
      const target = Math.atan2(e.clientY - cy, e.clientX - cx) * (180 / Math.PI) - 90

      let current = angles.get(btn) ?? target
      let diff = target - current
      // Shortest-path wrap so the transition never jumps the long way around
      diff = (((diff % 360) + 540) % 360) - 180
      current += diff
      angles.set(btn, current)
      ;(btn as HTMLElement).style.setProperty('--gradient-angle', `${current}deg`)
    })
  })

  import { inView } from 'motion'

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((group) => {
      const stop = inView(
        group,
        () => {
          stop()
          group.classList.add('is-revealed')
          ;[...group.children].forEach((child) => child.classList.add('xyz-in'))
        },
        { amount: 0.4 },
      )
    })
  })
</script>
